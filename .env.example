# ==============================================================================
# fin-ai Unified Monorepo Configuration Template (.env.example)
# Duplicate to .env and configure appropriate values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Orchestration & Ports (Docker / Local Dev)
# ------------------------------------------------------------------------------
APP_PORT=8080
BACKEND_PORT=8000
ENTERPRISE_PORT=3000
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Platform Database (teamwisedb: HR, Users, RBAC, Sessions, Audit)
# ------------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=teamwisedb
MYSQL_USER=teamwise
MYSQL_PASSWORD=change_me_to_secure_password
MYSQL_ROOT_PASSWORD=change_me_to_root_password

# ------------------------------------------------------------------------------
# 3. Reviews & Ingestion Database (timePayReview: Reviews, Ingestion, Taxonomy)
# ------------------------------------------------------------------------------
# Backend connection settings
REVIEW_MYSQL_HOST=127.0.0.1
REVIEW_MYSQL_PORT=3306
REVIEW_MYSQL_DATABASE=timePayReview
REVIEW_MYSQL_USER=root
REVIEW_MYSQL_PASSWORD=change_me_to_root_password

# Enterprise Node.js connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=timePayReview
DB_USER=root
DB_PASSWORD=change_me_to_root_password
DATABASE_URL=mysql://root:change_me_to_root_password@127.0.0.1:3306/timePayReview
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 4. Security, JWT & Authentication
# ------------------------------------------------------------------------------
# FastAPI Backend JWT secret (minimum 32 characters)
JWT_SECRET_KEY=change_this_to_at_least_32_characters_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Enterprise Node.js Backend JWT secret
JWT_SECRET=change_this_to_a_secure_enterprise_jwt_key
JWT_EXPIRES_IN=24h

# Service account credentials for Teamwise-to-Enterprise bridge
ENTERPRISE_SERVICE_EMAIL=admin@company.com
ENTERPRISE_SERVICE_PASSWORD=ChangeThisPassword123!
ENTERPRISE_SERVICE_NAME=Enterprise API Service
ENTERPRISE_API_URL=http://127.0.0.1:3000
ENTERPRISE_BRIDGE_EMAIL=admin@company.com
ENTERPRISE_BRIDGE_PASSWORD=ChangeThisPassword123!

# Rate limiting and lockout policies
ALLOW_PUBLIC_REGISTRATION=true
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_MAX_FAILURES=3
LOGIN_FAILURE_WINDOW_MINUTES=3
LOGIN_LOCKOUT_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=60

# ------------------------------------------------------------------------------
# 5. Email Notification Service (ZeptoMail / Zoho)
# ------------------------------------------------------------------------------
ZEPTOMAIL_API_URL=https://cpaas.zoho.in/v1.1/email
ZEPTOMAIL_API_KEY=your_zeptomail_api_key_here
ZEPTOMAIL_FROM_ADDRESS=noreply@npstx.com
ZEPTOMAIL_FROM_NAME=Teamwise

# ------------------------------------------------------------------------------
# 6. Frontend / UI Client Configuration
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
VITE_API_URL=

# ------------------------------------------------------------------------------
# 7. AI & Heuristic Classification (OpenRouter / LLM)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 8. Channel Ingestion Settings (Play Store, Chatbot, Email)
# ------------------------------------------------------------------------------
# General Ingestion Polling
POLL_INTERVAL_SECONDS=10
POLL_ON_START=true

# Google Play Store Review Scraper
APP_PACKAGE_NAME=com.npst.timepay.society
REVIEW_COUNTRY=in
REVIEW_LANGUAGES=en,hi
INITIAL_IMPORT_DAYS=30
OVERLAP_DAYS=7
MAX_REVIEWS_PER_LANGUAGE=5000
PLAYSTORE_POLL_INTERVAL_MINUTES=60

# Ingestion Upload Directories
UPLOADS_DIR=./enterprise/data/uploads
PROCESSED_DIR=./enterprise/data/uploads/processed
FAILED_DIR=./enterprise/data/uploads/failed
NON_SUPPORT_DIR=./enterprise/data/uploads/non-support

# GitHub Repository Email Dispatch Ingestion (Event: email-received)
GITHUB_EMAIL_REPO_URL=https://github.com/rishiraj1337/teamwise
GITHUB_REPO_OWNER=rishiraj1337
GITHUB_REPO_NAME=teamwise
GITHUB_EMAIL_BRANCH=main
GITHUB_EMAIL_FOLDER_PATH=data/incoming-emails
GITHUB_PAT=
EMAIL_POLLING_ENABLED=true
EMAIL_POLL_INTERVAL_SECONDS=30
EMAIL_MAX_POLL_INTERVAL_SECONDS=180

# ------------------------------------------------------------------------------
# 9. Enterprise Vault & Keycloak Integration (Optional)
# ------------------------------------------------------------------------------
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_PATH=secret/data/automation

KEYCLOAK_ENABLED=false
KEYCLOAK_REALM_URL=
KEYCLOAK_CLIENT_ID=

# ------------------------------------------------------------------------------
# 10. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
