# Copy this file to .env and replace the example secrets before running.

# Teamwise application database (Docker: teamwise-mysql on host port 3307)
MYSQL_DATABASE=teamwisedb
MYSQL_USER=teamwise
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Unified review database (Docker: timepay-review-mysql on host port 3306)
# Must match enterprise-review-platform DB settings (Play Store, email, chatbot → same `review` table).
REVIEW_MYSQL_DATABASE=timePayReview
REVIEW_MYSQL_HOST=127.0.0.1
REVIEW_MYSQL_PORT=3306
REVIEW_MYSQL_USER=root
# Leave empty to reuse MYSQL_PASSWORD; set explicitly when review DB uses root or another user.
REVIEW_MYSQL_PASSWORD=password

# Use a unique random value of at least 32 characters. For example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ZeptoMail (password reset emails)
ZEPTOMAIL_API_URL=https://cpaas.zoho.in/v1.1/email
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@npstx.com
ZEPTOMAIL_FROM_NAME=Teamwise
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_MINUTES=60

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# development | production (production hides /docs and OpenAPI)
APP_ENV=development
ALLOW_PUBLIC_REGISTRATION=true
AUTH_RATE_LIMIT_PER_MINUTE=20

# Lock sign-in after 3 wrong passwords within 3 minutes (for 1 hour). Forgot-password stays available.
LOGIN_MAX_FAILURES=3
LOGIN_FAILURE_WINDOW_MINUTES=3
LOGIN_LOCKOUT_MINUTES=60

# Enterprise Unified Review Platform (Node) — email/chatbot/playstore ingestion + /api/reviews
ENTERPRISE_API_URL=http://127.0.0.1:3000
ENTERPRISE_BRIDGE_EMAIL=admin@company.com
ENTERPRISE_BRIDGE_PASSWORD=AdminPassword123!
